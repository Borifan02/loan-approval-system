# Environment Configuration Template for Loan Approval AI System

# Model and Scaler Directory Paths (leave empty to use default local paths)
# MODEL_DIR=models/
# MODEL_PATH=models/rf_model.pkl
# SCALER_PATH=models/scaler.pkl

# Application Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Streamlit Configuration Options
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# SHAP Computation Settings
# Max samples for background dataset when computing TreeExplainer (default: 100)
SHAP_BACKGROUND_SAMPLES=100
